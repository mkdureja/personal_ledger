# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your-telegram-bot-token-here

# Comma-separated Telegram user IDs allowed to use this bot. Each authorized user
# gets a private, independent ledger. List each ID exactly once (duplicates, zero,
# and negatives are rejected at startup).
# Find your ID: message @userinfobot on Telegram
ALLOWED_USER_IDS=123456789,987654321

# Timezone for day-bucketing (used for streaks, summaries, reminders)
TZ=Asia/Kolkata

# Hour (0-23) in local time to send daily habit reminder.
# Used only when no routine.yaml is present (see routine.example.yaml).
REMINDER_HOUR=20

# Optional path to the routine anchors file. Defaults to routine.yaml in the
# project root; when that file exists it replaces the single reminder above.
# ROUTINE_PATH=routine.yaml

# SQLite database file path
DB_PATH=ledger.db
