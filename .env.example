# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your-telegram-bot-token-here

# Comma-separated Telegram user IDs allowed to use this bot. Each authorized user
# gets a private, independent ledger. List each ID exactly once (duplicates, zero,
# and negatives are rejected at startup).
# Find your ID: message @userinfobot on Telegram
ALLOWED_USER_IDS=123456789,987654321

# --- Phase 1 rollout (read once at startup; changes need a supervised restart) ---
# Comma-separated subset of ALLOWED_USER_IDS enabled for Phase 1 Home + fast
# mutations. Empty (the safe default) means Phase 1 is off for everyone.
PHASE1_ENABLED_USER_IDS=

# Persistent Home keyboard mode — exactly one of: off, pilot, on, remove.
#   off    = never send; does not force removal on every Home (use remove to roll back)
#   pilot  = send only to HOME_KEYBOARD_PILOT_USER_IDS; remove for other users
#   on     = send to every Phase 1-enabled user; remove for other users
#   remove = send ReplyKeyboardRemove to every authorized user (rollback)
HOME_KEYBOARD_MODE=off

# Comma-separated subset of PHASE1_ENABLED_USER_IDS. Consulted only in 'pilot' mode.
HOME_KEYBOARD_PILOT_USER_IDS=

# Timezone for day-bucketing (used for streaks, summaries, reminders)
TZ=Asia/Kolkata

# Hour (0-23) in local time to send daily habit reminder.
# Used only when no routine.yaml is present (see routine.example.yaml).
REMINDER_HOUR=20

# Optional path to the routine anchors file. Defaults to routine.yaml in the
# project root; when that file exists it replaces the single reminder above.
# ROUTINE_PATH=routine.yaml

# SQLite database file path
DB_PATH=ledger.db

# Directory that receives the verified pre-migration backup. It MUST resolve
# outside the project root; a value inside the repository is rejected at startup.
#
# Leaving it empty is fine while the schema is current. As soon as a migration is
# pending, startup refuses to run without it and makes no schema change -- that is
# the moment a rollback point actually matters. Never point this at cloud-synced
# storage: the file is a plaintext copy of the whole ledger.
# See docs/backup_runbook.md for the recorded destination and security policy.
BACKUP_DEST_DIR=

# --- Optional Gemini-assisted meal parsing (Release 4) ---
# Leave EMPTY to keep meal parsing fully deterministic and local. With no key the
# bot behaves exactly as it does today; the key only makes the capability
# available, and each user must still opt in with /aiparse on before any text is
# sent.
#
# Get a key from https://aistudio.google.com/apikey . Treat it like BOT_TOKEN:
# it is a live credential, it belongs only in this gitignored file, and if it is
# ever pasted into a chat, an issue, or a terminal transcript, revoke it and
# generate a new one -- generating a second key does not disable the first.
GEMINI_API_KEY=

# Parsing model, chosen by measuring the live free tier rather than by reputation:
#   gemini-flash-lite-latest  1.6s, correct, has quota   <- default
#   gemini-flash-latest       2.9s, correct, 5 req/min free
#   gemini-2.0-flash          free-tier quota of zero (unusable)
#   gemini-2.5-flash(-lite)   HTTP 404 on this tier
# Splitting a phrase into items needs no reasoning, so the lite tier fits. Change
# this only if you have a specific model in mind.
GEMINI_MODEL=gemini-flash-lite-latest

# --- Optional local voice notes (Release 5) ---
# Off by default because turning it on downloads a speech model (hundreds of MB)
# the first time a note arrives. Requires `pip install -r requirements-voice.txt`;
# without that package the bot still runs and voice notes reply "type it instead".
#
# Unlike Gemini parsing there is no consent switch, because the audio never
# leaves this machine — that is exactly why transcription is local while meal
# text may be sent to a parser. Recordings are deleted immediately after
# transcription and are never stored or attached to a log.
VOICE_ENABLED=false

# Whisper model size: tiny, base, small, medium, large-v3.
# "base" is the smallest that handles ordinary meal dictation; "tiny" is faster
# and noticeably worse at food names. Larger sizes cost disk, memory, and time.
VOICE_MODEL_SIZE=base

# Hard cap on accepted audio length, in seconds. Checked against Telegram's own
# metadata before anything is downloaded, so an over-long note costs nothing.
VOICE_MAX_SECONDS=60
