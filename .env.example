# Telegram Bot Token (get from @BotFather)
BOT_TOKEN=your-telegram-bot-token-here

# Comma-separated Telegram user IDs allowed to use this bot. Each authorized user
# gets a private, independent ledger. List each ID exactly once (duplicates, zero,
# and negatives are rejected at startup).
# Find your ID: message @userinfobot on Telegram
ALLOWED_USER_IDS=123456789,987654321

# --- Phase 1 rollout (read once at startup; changes need a supervised restart) ---
# Comma-separated subset of ALLOWED_USER_IDS enabled for Phase 1 Home + fast
# mutations. Empty (the safe default) means Phase 1 is off for everyone.
PHASE1_ENABLED_USER_IDS=

# Persistent Home keyboard mode — exactly one of: off, pilot, on, remove.
#   off    = never send; does not force removal on every Home (use remove to roll back)
#   pilot  = send only to HOME_KEYBOARD_PILOT_USER_IDS; remove for other users
#   on     = send to every Phase 1-enabled user; remove for other users
#   remove = send ReplyKeyboardRemove to every authorized user (rollback)
HOME_KEYBOARD_MODE=off

# Comma-separated subset of PHASE1_ENABLED_USER_IDS. Consulted only in 'pilot' mode.
HOME_KEYBOARD_PILOT_USER_IDS=

# Timezone for day-bucketing (used for streaks, summaries, reminders)
TZ=Asia/Kolkata

# Hour (0-23) in local time to send daily habit reminder.
# Used only when no routine.yaml is present (see routine.example.yaml).
REMINDER_HOUR=20

# Optional path to the routine anchors file. Defaults to routine.yaml in the
# project root; when that file exists it replaces the single reminder above.
# ROUTINE_PATH=routine.yaml

# SQLite database file path
DB_PATH=ledger.db
