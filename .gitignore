.env
routine.yaml
codex_review.md
*.db
# SQLite WAL sidecar files carry live, uncommitted state. Never commit them, and
# never back up ledger.db without them (see docs/backup_runbook.md).
*.db-wal
*.db-shm
*.db-journal
# Database backups (real user data) — never commit.
*.db.bak*
*.bak-*
# Single-instance lock file (see bot/instance_lock.py). Ownership is the OS lock
# on an open handle, not the file's existence, so a leftover file is harmless.
*.instance.lock
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/
dist/
build/
.venv/
venv/
